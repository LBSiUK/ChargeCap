#!/bin/sh
# Start (or restart) the daemon and show the app on the home screen.
PATH=@PREFIX@/usr/bin:@PREFIX@/bin:$PATH
PLIST=@PREFIX@/Library/LaunchDaemons/uk.lbsi.chargecap.plist
launchctl unload "$PLIST" 2>/dev/null
launchctl load "$PLIST"
[ -f /var/mobile/Library/Preferences/uk.lbsi.chargecap.plist ] && chown 501:501 /var/mobile/Library/Preferences/uk.lbsi.chargecap.plist
# iOS 9's uicache (uikittools 1.x) only knows a full refresh, run as mobile; today's takes the one app.
case "$(dpkg-query -W -f='${Version}' uikittools 2>/dev/null)" in
    1.*) su mobile -c uicache 2>/dev/null || uicache 2>/dev/null ;;
    *) uicache -p @PREFIX@/Applications/ChargeCap.app ;;
esac
exit 0
